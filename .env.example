# Copy to .env. Actual secrets belong ONLY in the ignored .env.
GEMINI_API_KEY=
# Use /api/config/models to list models available to your key; select a Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_REQUEST_BUDGET=20
GEMINI_MAX_CALLS_PER_ANALYSIS=4
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=patchpilot_ai
DATABASE_USER=patchpilot_user
DATABASE_PASSWORD=
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_REMOTE_WRITE_ENABLED=false
LOCAL_TEST_EXECUTION_ENABLED=false
BANKING_REPOSITORY_URL=https://github.com/TitanOfTime/TestBankingApp
CORS_ALLOWED_ORIGINS=http://localhost:3000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
